{
  "expo": {
    "name": "Wellbeing",
    "slug": "wellbeing-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f172a",
    "ios": {
      "bundleIdentifier": "com.pradiconsulting.wellbeing",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pradiconsulting.wellbeing",
      "adaptiveIcon": {
        "backgroundColor": "#0f172a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0f172a"
        }
      ],
      [
        "expo-notifications",
        {
          "mode": "production"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Wellbeing uses Face ID to keep your journal and mood history private."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "coachApiUrl": "https://wellbeing-app.replit.app",
      "revenueCatIosKey": "appl_RHHKvoJVExYvcRTffWRNfwBGNuz"
    }
  }
}
